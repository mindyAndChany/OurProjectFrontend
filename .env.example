# ===== OurProjectFrontend — משתני סביבה לפריסה בענן =====
# כל משתנה שמתחיל ב-VITE_ נצרב לתוך הבנייה של Vite,
# לכן חייבים להגדיר אותם בזמן ה-Build בענן (ולא רק בזמן ריצה).

# --- כתובת ה-API של הבקאנד ---
# אחרי שהבקאנד יעלה לענן, שימי כאן את הכתובת הציבורית שלו.
# דוגמה: https://edulink-api.onrender.com
VITE_BACKEND_URL=https://<your-backend-domain>

# --- Firebase (Web SDK) ---
VITE_FIREBASE_API_KEY=<firebase-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
VITE_FIREBASE_APP_ID=<app-id>
